PORT=5000
NODE_ENV=development
JWT_SECRET=voicebridge-ai-super-secret-jwt-key-development-2026

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Direct PostgreSQL Connection (For running migrations directly via npm run db:migrate)
# Format: postgresql://postgres.[project-id]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
